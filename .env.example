# ============================================================
# AI 엑셀 분석 서비스 — 환경 변수 템플릿
# ============================================================
# 사용 방법:
#   1. 이 파일을 복사해 .env.local 파일을 만듭니다.
#      PowerShell: copy .env.example .env.local
#   2. 아래 값을 본인 계정에서 발급받은 키로 채웁니다.
#   3. .env.local은 Git에 올리지 마세요!
#
# 자세한 Step-by-Step: docs/07_environment_setup_guide.md
# ============================================================

# ── Supabase (Dashboard → Settings → API) ──────────────────
# Project URL — 브라우저에 노출 가능 (NEXT_PUBLIC_ 접두사)
NEXT_PUBLIC_SUPABASE_URL=

# anon public key — 브라우저에 노출 가능, RLS로 보호됨
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — 서버 전용, 절대 공개·커밋 금지
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (platform.openai.com → API keys) ────────────────
# API Key — 서버 전용, 절대 공개·커밋 금지
OPENAI_API_KEY=

# Assistant ID — 코드에서 Assistant를 재사용할 경우 (선택)
OPENAI_ASSISTANT_ID=

# ── 사이트 URL (로컬 / Vercel 배포) ─────────────────────────
# 로컬: http://localhost:3000
# Vercel: https://your-app-name.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
